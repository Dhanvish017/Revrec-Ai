# Copy to .env and fill in real values. Never commit .env.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required: server-side key from Supabase Dashboard > Settings > API > service_role.
# NEVER expose this key to a frontend/browser build.
SUPABASE_SERVICE_ROLE_KEY=
PORT=5000

# Deployed RevRec AI Python ML service (FastAPI, see ../ml/app.py).
# Used by services/mlService.js for POST /api/retry/predict/:paymentId.
ML_SERVICE_URL=https://revrec-ai.onrender.com

# Razorpay Test Mode — already configured on Render as env vars.
# Fill these in locally only if you want to hit /api/razorpay/create-order on your machine.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when creating the webhook in Razorpay Dashboard > Settings > Webhooks —
# whatever secret you enter there must match this value exactly.
RAZORPAY_WEBHOOK_SECRET=
